# 실제 값은 .env 파일에 넣고 커밋하지 않는다(.gitignore에 포함).

# MySQL 접속 정보 (DB설계서 기준 utf8mb4)
DATABASE_URL=mysql+pymysql://user:password@localhost:3306/myfav?charset=utf8mb4

# AI 모델 제공사·모델. API명세서 5.2절: 코드를 다시 배포하지 않고 이 값만 바꿔서 전환한다.
AI_PROVIDER=openai
AI_MODEL=gpt-5.4-mini
OPENAI_API_KEY=
# AI_PROVIDER=anthropic 로 바꾸면 아래 키와 AI_MODEL=claude-sonnet-4-6 를 사용한다.
ANTHROPIC_API_KEY=

# 외부 API 키 (서버에만 둔다. 클라이언트에 노출하지 않는다)
TMDB_API_KEY=
KAKAO_REST_API_KEY=
OPENTRIPMAP_API_KEY=

# CORS로 허용할 프론트엔드 출처
CORS_ORIGINS=http://localhost:5173

# 이미지 풀(여행지/무드 겸용) 정적 파일 URL을 만들 때 쓰는 서버 공개 주소
PUBLIC_BASE_URL=http://localhost:8000
